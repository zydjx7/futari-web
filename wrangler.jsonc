{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "private-notes-local",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notes-db",
      // Keep the local emulator on its original database.
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "notes-files" }],
  "env": {
    "production": {
      "name": "private-notes",
      "account_id": "dbc5da6a121c0d4cf70a752b6b638259",
      "workers_dev": true,
      "preview_urls": false,
      "secrets": { "required": ["PASSCODE_HER", "PASSCODE_ADMIN", "SESSION_SECRET"] },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "notes-db",
        "database_id": "5bfe8189-aef8-49da-b3d6-a48c1a5d87b8",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "notes-files" }]
    }
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.client.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.webp"], "fallthrough": true }
  ]
}
